# ---- Database ----
DATABASE_URL="postgresql://admin@localhost:5432/ashram_management?schema=public"
# Used by `npm run test:e2e`, which drops and reseeds it. Defaults to DATABASE_URL
# with "_test" appended; the database name must end in "_test".
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ashram_management_test?schema=public"

# ---- API ----
API_PORT=4300
NODE_ENV=development
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"
SESSION_TTL_HOURS=12
WEB_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN=

# ---- Storage (S3-compatible). driver=local|s3 ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=
S3_REGION="ap-south-1"
S3_BUCKET="ashram-management"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Uploads ----
MAX_UPLOAD_MB=10

# ---- Web (Vite) ----
VITE_API_URL="http://localhost:4300/api"

# ---- WhatsApp ----
# 32-byte key that encrypts Cloud API tokens and linked-device sessions.
# Generate with: openssl rand -base64 32   (there is deliberately no default)
WHATSAPP_ENCRYPTION_KEY=
# Browser/QR linking drives a personal account through WhatsApp Web's protocol.
WHATSAPP_WEB_ENABLED=true
# Hard monthly cap on QR-linked sends, per organization (ban protection).
WHATSAPP_MONTHLY_LIMIT=250
WHATSAPP_GRAPH_VERSION=v21.0
# Cloud API webhook: the verify token you enter in the Meta app dashboard,
# and the app secret Meta signs every callback with.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# "Connect with Facebook" (Meta login) for the Cloud API: the Meta app ID, used
# with WHATSAPP_APP_SECRET above. In the Meta app: add the WhatsApp product and Facebook
# Login for Business, and list ${API_PUBLIC_URL}/api/whatsapp/oauth/callback
# under Valid OAuth Redirect URIs. Without WHATSAPP_APP_ID, only manual token
# entry is offered.
WHATSAPP_APP_ID=
# The API's public base URL (no /api), used to build the OAuth redirect URI.
API_PUBLIC_URL="http://localhost:4300"
# Sharing one Meta app with another product (e.g. CAThrives)? The app's webhook
# URL points there; set this to true so every WhatsApp Business account connected
# here is subscribed with this server's own callback URL (needs an https
# API_PUBLIC_URL and WHATSAPP_WEBHOOK_VERIFY_TOKEN). Don't connect the same
# account to both products — its webhooks can only go to one of them.
WHATSAPP_WEBHOOK_OVERRIDE=false
