# SSPMA — prod environment (built from `main`, deployed when a person ticks
# "deploy" on a manual run of .github/workflows/build.yml).
#
# NOT SECRET. This file is committed and is read in two places, which must
# agree:
#
#   1. Compose interpolates ENVIRONMENT, APP_HOST and the memory limits into
#      deploy/compose.yaml on the server.
#   2. CI reads VITE_API_URL out of it and compiles it into the web bundle.
#
# So a VITE_* change here does nothing until the image is REBUILT.
#
# Credentials live in /opt/platform/secrets/applications/sspma/prod.env, which
# the API reads through env_file: and which is never committed.

# Exactly `prod`. Never `production`.
ENVIRONMENT=prod

# One hostname for both tiers: the web app at /, the API at /api.
APP_HOST=sspma.nirantix.com

# ── Baked into the web bundle at build time ─────────────────────────────────

# Relative on purpose. The API is on the same origin, so the browser needs no
# CORS preflight and the session cookie needs no shared parent domain.
VITE_API_URL=/api

# ── Deployment shape ────────────────────────────────────────────────────────

API_MEMORY_LIMIT=768M
WEB_MEMORY_LIMIT=64M

# Empty except during a hostname move, when it keeps the old name answering
# alongside the new one. Carries its own leading comma and backticks:
#   APP_EXTRA_HOSTS=", `old.example.com`"
# Check the rendered rules before `up -d` — a malformed rule does not fail the
# command, Traefik just answers its own 404:
#   docker compose --env-file deploy/prod.env -f deploy/compose.yaml config | grep '\.rule='
APP_EXTRA_HOSTS=
